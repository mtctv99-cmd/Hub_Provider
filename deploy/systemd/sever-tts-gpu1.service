[Unit]
Description=Sever Provider Piper TTS on GPU 1
After=sever-provider.service

[Service]
Type=simple
WorkingDirectory=/media/reup/Data_sv4/Sever_provider
EnvironmentFile=%h/.config/sever-provider/worker.env
Environment=PYTHONUNBUFFERED=1
Environment=CUDA_VISIBLE_DEVICES=1
Environment=LD_LIBRARY_PATH=/media/reup/Data_sv4/Sever_provider/venv_tts/lib/nvidia:/home/reup/.local/lib/python3.12/site-packages/nvidia/cu13/lib:/home/reup/.local/lib/python3.12/site-packages/nvidia/cudnn/lib
ExecStart=/media/reup/Data_sv4/Sever_provider/venv_tts/bin/python scripts/local_tts_worker.py --server ws://127.0.0.1:18080/api/llm/ws/worker --worker-id tts-worker-gpu1 --models-dir models --queue-size 3 --concurrency 10 --threads-per-voice 3 --gpu --device-id 1
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
